PORT=5000
# Supabase PostgreSQL connection string (Transaction Mode - port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
JWT_SECRET=your_super_secret_jwt_key_change_in_production
NODE_ENV=production
# Your deployed Vercel frontend URL (e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app
